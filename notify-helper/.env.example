# 알림톡 발송 도우미 설정
# 이 파일을 notify-helper/.env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않음)
#   cp notify-helper/.env.example notify-helper/.env
# API 키와 발신 프로필 키는 채팅이나 메일에 붙여넣지 말고 이 파일에 직접 입력하세요.
# 주석은 줄 맨 앞의 # 만 인식합니다. 값 뒤에 주석을 달지 마세요.

# ── 발송 스위치 ───────────────────────────────────────────
# 킬스위치. false 면 DRY-RUN 을 포함해 모든 발송을 거부합니다. 비우면 켜짐(true)
NOTIFY_ENABLED=

# true(기본): 비즈고를 호출하지 않고 요청 내용만 확인. 실제로 보내려면 false
NOTIFY_DRY_RUN=true

# ── 비즈고 ───────────────────────────────────────────────
# 비즈고 OMNI API V2 통합키. mars_ak_ 로 시작합니다. 이 파일에서만 읽습니다 (환경변수로 넘겨도 무시)
BIZGO_API_KEY=

# 아래 두 주소만 허용합니다. 다른 주소면 도우미가 시작하지 않습니다.
#   샌드박스(기본, 실제 발송·과금 없음): https://sandbox-mars.ibapi.kr/api/comm
#   운영:                             https://mars.ibapi.kr/api/comm
BIZGO_BASE_URL=https://sandbox-mars.ibapi.kr/api/comm

# 카카오 비즈메시지 발신 프로필 키 (@부산인력개발원). DRY-RUN 에서는 없어도 됩니다
BIZGO_SENDER_KEY=

# 사용할 템플릿 코드. templates.json 에서 같은 이름의 설정(문구 · 버튼)을 자동으로 고릅니다.
#   01000_2_21             강사용 시간표 변경 안내 v2, 변경 내용 포함 (비즈고 등록본, 평소에 씀)
#   01000_2_20             강사용 시간표 변경 안내 v1, 변경 내용 없음 (예비)
#   education_scheduled_v1 비즈고 기본 템플릿, 연동 테스트용 (NOTIFY_TEST_PHONE 필수)
BIZGO_TEMPLATE_CODE=

# (선택) 알림톡 실패 시 문자로 대체발송할 발신번호(비즈고에 등록된 번호). 비우면 대체발송 안 함
BIZGO_SMS_FROM=

# (선택) 정산용 부서코드
BIZGO_PAYMENT_CODE=

# ── 공인 IP ──────────────────────────────────────────────
# 비즈고 연동관리에 등록한 허용 IP. "이 도우미가 도는 PC 의 공인 IP" 입니다 (GitHub Pages 주소 아님).
# 쉼표로 구분, CIDR 가능. 예: 203.0.113.10 또는 203.0.113.0/24
# 발송 직전에 https://api.ipify.org 로 현재 공인 IP 를 확인해, 목록에 없으면 발송을 막습니다.
# 비우면 비교하지 않고 경고만 합니다.
EXPECTED_PUBLIC_IPS=

# ── 테스트 ───────────────────────────────────────────────
# 값이 있으면 누구에게 보내든 모든 알림을 이 번호로만 보냅니다. 운영 전환 시 반드시 비우기
NOTIFY_TEST_PHONE=

# ── 남용 방지 (비우면 괄호 안 기본값) ──────────────────────
# 한 번에 보낼 수 있는 최대 인원 (50)
NOTIFY_MAX_RECIPIENTS=
# 시간당 발송 요청 수 (5). 샌드박스 · 운영만 셉니다
NOTIFY_MAX_REQUESTS_PER_HOUR=
# 하루 발송 건수 (200). 샌드박스 · 운영만 셉니다
NOTIFY_MAX_SENDS_PER_DAY=
# 같은 번호에 다시 보내기까지 기다리는 시간, 분 (10)
NOTIFY_PHONE_COOLDOWN_MIN=

# ── 관리자 화면 ──────────────────────────────────────────
# 발송을 허용할 관리자 화면 주소. 쉼표로 구분하고 경로(/time-schedule/)는 빼고 적습니다.
#   운영(팀장님 PC):  https://pycode1094.github.io
#   개발(내 PC):     http://localhost:5173
# 비우면 http://localhost:5173, http://127.0.0.1:5173, https://pycode1094.github.io
ALLOWED_ORIGINS=
