# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않음)
#   cp .env.example .env.local
#
# 개발 서버(npm run dev)의 관리자 API 비밀번호.
# 비어 있으면 관리자 로그인/업로드가 모두 거부됩니다.
# 운영 Worker 는 이 파일을 쓰지 않고 `wrangler secret put ADMIN_PASSWORD` 로 설정합니다.
ADMIN_PASSWORD=

# ── 강사 알림 ─────────────────────────────────────────────
# VITE_ 로 시작하는 값은 빌드된 화면(공개 JS)에 그대로 들어갑니다. 비밀 값을 넣지 마세요.
#
# 알림 방식 (비우면 helper)
#   helper 업로드하는 PC 의 발송 도우미(notify-helper/)가 비즈고 API 로 직접 보낸다
#   tis    업로드 후 알림 대상 강사를 엑셀 · 번호 복사로 TIS 에 넘긴다 (보류)
VITE_NOTIFY_MODE=

# (helper) 알림톡 발송 도우미 주소. 비우면 http://127.0.0.1:5599
# 도우미 설정은 notify-helper/.env 에 따로 있습니다 (notify-helper/README.md 참고).
VITE_NOTIFY_HELPER_URL=

# (tis) TIS 발송 화면 주소. 비우면 [TIS 발송 화면 열기] 버튼이 꺼지고 "TIS 주소 미설정"으로 표시
VITE_TIS_SEND_URL=
